rules_version = '2';

// In a client-only SPA the route guards in src/features/auth are user experience, not
// security — anyone can open devtools and call Firestore directly. These rules are the
// only real enforcement, so they deny by default and open up one collection at a time.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------------
    // Defined once here so every collection added in later phases reuses the same
    // definition of "signed in", "admin" and "active".

    function isSignedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return profileExists() && profile().active == true;
    }

    function isAdmin() {
      return isActive() && profile().role == 'admin';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- Field allow-listing -----------------------------------------------
    // Every validated write below states the EXACT set of keys its document may carry.
    // Checking only the fields a rule names leaves the door open to extra ones: nothing
    // reads them today, but without this a client can attach `discount`, `paid` or
    // `refunded` to any create, and the first feature that read such a field would be
    // reading something a client invented rather than something this system wrote.
    //
    // `required` must all be present, `optional` may be. Two things are load-bearing:
    //
    //   * this is evaluated against request.resource.data, which on an UPDATE is the MERGED
    //     document rather than the delta — so the list must name every key the document has
    //     ever carried, `createdAt` included, not just the ones being written;
    //   * the key set for each collection is taken from the writer that produces it (the
    //     *-api.ts files). If a rule and its writer disagree, the writer is the thing to
    //     re-read — the rule should describe what the app actually writes.

    function hasFields(required, optional) {
      return request.resource.data.keys().hasAll(required)
        && request.resource.data.keys().hasOnly(required.concat(optional));
    }

    // ---- Account identity ---------------------------------------------------
    // Orders, payments, fulfilment steps and voids each record TWO identities: the POS
    // operator (validated by validOperator, below) and the signed-in Firebase account that
    // wrote the record. The operator half has always been verified; the account half was
    // only ever checked as `is string`, so any signed-in user could stamp an arbitrary name
    // onto the account that rang a sale up — weakening the audit trail these pairs exist to
    // provide. Both halves are now judged against a source of truth.
    //
    // The uid is checked separately, against request.auth.uid, at each call site. This only
    // has to tie the NAME to the profile that uid belongs to, which is the same comparison
    // isSelfOperator already makes. profile() is fetched by isActive() on every one of these
    // paths and rules cache a get() on a path, so it costs no extra document access.

    function accountNameMatches(name) {
      return 'displayName' in profile() && name == profile().displayName;
    }

    // ---- users -------------------------------------------------------------
    // A staff member may read their own profile (the app subscribes to it live so a
    // role change or a deactivation takes effect without a re-login). Only an admin
    // may read anyone else's.
    //
    // Writing is an admin's, with exactly one exception: anybody may change their own
    // `displayName`, which is what the Settings page does. The exception is drawn as
    // narrowly as it can be — `affectedKeys().hasOnly(['displayName'])` means a self-write
    // that also touches `role`, `active`, `email`, `uid` or `createdAt` is refused
    // outright, as is one that invents a field. So the two things these rules have always
    // stopped a staff account from doing — promoting itself to admin, reactivating itself
    // — are stopped by exactly the same clause as before.
    //
    // Note what this does NOT weaken. The name recorded against an order is the POS
    // operator's, taken from `staffMembers`, which only an admin may write; the account
    // name is the second half of the pair and is verified by accountNameMatches() against
    // this document at the moment of the write. Renaming yourself therefore renames you on
    // what you do NEXT, and cannot rewrite a single record already written — those hold
    // their own snapshot and orders are immutable.

    function validDisplayName(name) {
      return name is string
        && name.trim().size() > 0
        && name.size() <= 60;
    }

    function renamesSelfOnly(uid) {
      return isSelf(uid)
        && isActive()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validDisplayName(request.resource.data.displayName);
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || renamesSelfOnly(uid);
    }

    // ---- Menu catalog ------------------------------------------------------
    // Any signed-in, active user reads the menu — staff need it to serve customers.
    // Only an admin writes it.
    //
    // The shape checks below are not duplicated form validation: the form is not the
    // security boundary. Anyone can call Firestore straight from devtools, so the
    // invariants the rest of the system relies on — above all that `price` is a whole
    // number of sen and never a float — are enforced here, at the database.

    function validCategory() {
      let d = request.resource.data;
      // Key set from createCategory/updateCategory in src/features/menu/menu-api.ts.
      // createdAt is listed because an update merges it back in, not because one is written.
      return hasFields(['name', 'sortOrder', 'active', 'createdAt', 'updatedAt'], [])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.sortOrder is int
        && d.active is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function validMenuItem() {
      let d = request.resource.data;
      // Key set from createMenuItem/updateMenuItem in src/features/menu/menu-api.ts.
      // `description` is optional: the form always sends one, but an item written without
      // it is legitimate and the check below already tolerates its absence.
      return hasFields(
          ['name', 'categoryId', 'price', 'sortOrder', 'active', 'createdAt', 'updatedAt'],
          ['description'])
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.categoryId is string && d.categoryId.size() > 0
        && d.price is int && d.price >= 0
        && d.sortOrder is int
        && d.active is bool
        && (!('description' in d.keys())
            || (d.description is string && d.description.size() <= 300));
    }

    match /categories/{categoryId} {
      allow read: if isActive();
      allow create, update: if isAdmin() && validCategory();
      allow delete: if isAdmin();
    }

    // Deleting an item must take its cost with it. deleteMenuItem() in menu-api.ts already
    // batches both, but until now nothing made that mandatory: a direct delete of the item
    // alone passed, stranding an admin-only menuItemCosts document that no screen would ever
    // show again. `existsAfter` asks whether the cost is still there once the write lands, so
    // the batched delete passes and the lone one does not — turning what the comment below
    // calls a limit rules cannot enforce into one they can.
    match /menuItems/{itemId} {
      allow read: if isActive();
      allow create, update: if isAdmin() && validMenuItem();
      allow delete: if isAdmin()
        && !existsAfter(/databases/$(database)/documents/menuItemCosts/$(itemId));
    }

    // ---- Menu item customisation (admin-configured, staff-readable) --------
    // What a customer may choose when an item is ordered: "No vegetables", "Extra egg
    // +RM1.00". One document per GROUP, keyed to its menu item by `itemId`, with the group's
    // options held as an array inside it.
    //
    // Staff READ this — they cannot take an order without knowing what to ask — and only an
    // admin writes it, which is the same split as menuItems and categories. Nothing here is
    // sensitive the way cost is, so it does not need a collection of its own to hide it; it
    // is separate from menuItems because it is a list per item, not a field.
    //
    // **What these rules cannot check.** The options are a list, and rules cannot iterate
    // one, so an option's name and price adjustment are validated by the form and by
    // parseModifierGroup rather than here — the same limitation, and the same honest
    // statement of it, as the `lines` array on an order. What is checked is every scalar and
    // the list's own type and size, so a group cannot be created without a real item, a
    // legal selection mode, or with an unbounded number of options.
    //
    // Note what does NOT depend on any of this: a past order. Every chosen option is copied
    // onto the order line at the time of sale, so an admin editing, deactivating or deleting
    // a group changes what the next customer is offered and nothing that has already been
    // rung up.

    function validModifierGroup() {
      let d = request.resource.data;
      // Key set from createModifierGroup/updateModifierGroup in src/features/menu/menu-api.ts.
      return hasFields(
          ['itemId', 'name', 'selection', 'required', 'sortOrder', 'active', 'options',
           'createdAt', 'updatedAt'], [])
        && d.itemId is string && d.itemId.size() > 0
        // The group must belong to an item that exists, so a stray document cannot be
        // created against a typo and then surface on no screen at all.
        && exists(/databases/$(database)/documents/menuItems/$(d.itemId))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && (d.selection == 'single' || d.selection == 'multiple')
        && d.required is bool
        && d.sortOrder is int
        && d.active is bool
        && d.options is list && d.options.size() > 0 && d.options.size() <= 30
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /modifierGroups/{groupId} {
      allow read: if isActive();
      allow create, update: if isAdmin() && validModifierGroup();
      allow delete: if isAdmin();
    }

    // ---- Item cost (admin only) --------------------------------------------
    // What the café pays for an item lives in its OWN collection, keyed by the same
    // document id as the menu item, rather than as a field on menuItems.
    //
    // That is not a stylistic choice. Firestore rules grant or deny a whole document —
    // there is no field-level read permission. Staff must read menuItems to serve
    // customers, so any field on that document is readable by staff, and merely hiding a
    // column in the UI would leave the cost one devtools tab away. Splitting the
    // collection is what actually makes "staff cannot see cost" true.
    //
    // Profit is deliberately not computed or stored anywhere: that belongs to the
    // reporting phase, which will also have to snapshot cost onto each order line,
    // because today's cost cannot answer what last month's margin was.

    function validItemCost() {
      let d = request.resource.data;
      // Key set from writeCost in src/features/menu/menu-api.ts, which uses set() rather
      // than update() — so this document is always written whole.
      return hasFields(['cost', 'updatedAt'], [])
        && d.cost is int && d.cost >= 0
        && d.updatedAt is timestamp;
    }

    // A cost must belong to a real menu item, so an orphan cannot be created in the
    // first place.
    //
    // `existsAfter` rather than `exists` is load-bearing: the app writes a new item and
    // its cost in one batch, and `exists` evaluates against the state *before* the batch
    // commits, so it would refuse the item's own cost. `existsAfter` asks whether the
    // item is there once the batch has landed, which is the question actually being asked.
    //
    // Rules cannot REQUIRE a companion write, but they can refuse the state a missing one
    // would leave behind — which is how the menuItems delete rule below now forces the cost
    // to go with the item. deleteMenuItem() has always batched both; the difference is that
    // skipping it is no longer possible.
    function menuItemExistsAfter(itemId) {
      return existsAfter(/databases/$(database)/documents/menuItems/$(itemId));
    }

    match /menuItemCosts/{itemId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validItemCost() && menuItemExistsAfter(itemId);
      allow delete: if isAdmin();
    }

    // ---- Cost history (admin only, append-only) ----------------------------
    // Costs change over time, and margin for a past sale is unanswerable unless the cost
    // in force at the time is recorded. Staff cannot read costs, so they cannot stamp one
    // onto an order they ring up — instead an admin's cost edits are journalled here, and
    // reporting later resolves an order's cost by date. Append-only: correcting history is
    // not editing it.

    // The orphan guard matters more here than anywhere else in the file. Reporting resolves
    // an order line's historical cost by `itemId` (resolveCostAtTime in
    // src/features/reports/aggregate.ts), so an entry journalled against an id no menu item
    // has is not merely stray data — it is a cost that silently applies to nothing while
    // looking like a real one, and the journal is append-only, so it could never be removed.
    // `existsAfter` rather than `exists` for the same reason menuItemExistsAfter uses it:
    // a new item and its first history entry land in the SAME batch.

    function validCostHistory() {
      let d = request.resource.data;
      return hasFields(['itemId', 'cost', 'effectiveFrom', 'recordedBy'], [])
        && d.itemId is string && d.itemId.size() > 0
        && menuItemExistsAfter(d.itemId)
        && (d.cost == null || (d.cost is int && d.cost >= 0))
        && d.effectiveFrom is timestamp
        && d.recordedBy == request.auth.uid;
    }

    match /menuItemCostHistory/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validCostHistory();
      allow update, delete: if false;
    }

    // ---- Staff identities --------------------------------------------------
    // Named people who operate the till, WITHOUT a Firebase account each. A stall shares
    // one device and one login across a shift; these records answer "who rang this up".
    //
    // They carry no permissions of their own — the signed-in Firebase role is still the
    // only authorisation boundary. Any active user reads the list, because the till's
    // picker needs it; only an admin writes it.
    //
    // There is NO delete. A record that past orders point at should not be removable by
    // accident, so `active` is the only way to retire someone.

    function validStaffMember() {
      let d = request.resource.data;
      // Key set from src/features/staff/staff-api.ts.
      return hasFields(['name', 'active', 'createdAt', 'updatedAt'], [])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.active is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /staffMembers/{staffId} {
      allow read: if isActive();
      allow create, update: if isAdmin() && validStaffMember();
      allow delete: if false;
    }

    // ---- Orders (immutable, and created UNPAID) ----------------------------
    // Any active user may ring up a sale and read the day's orders — staff work the till.
    // Nobody may change or remove one afterwards, admins included: a sale is a financial
    // record. A void writes a counter-entry, and a payment writes its own document; neither
    // ever mutates the original.
    //
    // Note the boundary of what these checks can cover. Rules cannot iterate or sum a
    // list, so `total` CANNOT be verified against `lines` here, and the lines themselves
    // cannot be shape-checked one by one — that is guarded by the pure functions in
    // src/features/pos/cart.ts and their unit tests, which is a client-side guard and
    // therefore not a control. What rules can check, and do, is every scalar: the exact set
    // of keys, types, ranges, formats, that the sale is attributed to the caller and to a
    // real active operator, and that it claims nothing about having been paid.
    //
    // This is the one gap in this file that is not closable here rather than merely unclosed.
    // See "What the rules cannot enforce" in README.md for what it would take and why the
    // residual risk is stated openly instead of being papered over.
    //
    // **An order may not carry payment at all.** Taking money is a separate, later step
    // recorded in orderPayments/{orderId}. Orders written before that step existed do carry
    // these fields and are read as paid, which is deliberate — see payments.ts. Refusing
    // them on a *new* order is what stops a client minting an order that claims to be
    // already paid and so never appears in the outstanding list.

    function carriesNoPayment(d) {
      return !('paymentMethod' in d.keys())
        && !('cashTendered' in d.keys())
        && !('changeGiven' in d.keys());
    }

    // **Every new order is dine-in or takeaway, and exactly one of the two carries a table
    // number.** A table number is an IDENTIFIER, not a resource: nothing here reserves,
    // occupies or de-duplicates one, and several orders may legitimately share "5".
    //
    // Takeaway must not carry the key AT ALL — absent, not null — for the same reason
    // carriesNoPayment refuses a null paymentMethod. Present-but-empty is a third state
    // nothing could classify, and a stale client sending one should fail loudly rather than
    // write an order whose type cannot be read back.
    //
    // Written as a ternary rather than one flat conjunction because on a takeaway order
    // `d.tableNumber` does not exist, and reading a missing field is an evaluation ERROR,
    // not null. The read must be reachable only on the branch where the field is guaranteed
    // to be there. The enum check comes FIRST so a garbage orderType is rejected on its own
    // terms rather than falling into the takeaway branch and passing by accident.
    //
    // `matches()` rather than a size check because rules have no trim(), so `size() > 0`
    // would accept "   " from a client that skipped the form. The pattern mirrors
    // TABLE_NUMBER_PATTERN in src/features/pos/order-type.ts; keep the two in step.
    //
    // Both fields are written once, with the order, and orders are immutable — so a mistyped
    // table number is corrected the way any other mistake on a sale is: void and re-ring.

    function validService(d) {
      return d.orderType in ['dine_in', 'takeaway']
        && (d.orderType == 'dine_in'
            ? (d.tableNumber is string && d.tableNumber.matches('^[A-Za-z0-9]{1,8}$'))
            : !('tableNumber' in d.keys()));
    }

    // An order names the identity that operated the till. Two forms are valid.
    //
    // 1. The signed-in account itself. Every user always has this, which is what keeps a
    //    till able to sell: a staff-role user cannot create staff identities, so if the
    //    roster were the only source of operators, an empty one would stop the stall
    //    trading with no way for the person at the counter to fix it. This is exactly the
    //    attribution orders carried before staff identities existed.
    //
    // 2. A named staff member, who must exist, be active, and whose CURRENT name must
    //    match the name stored on the order.
    //
    // Together with order immutability, form 2 gives both halves of what history needs:
    // the snapshot was provably accurate when taken, and a later rename cannot rewrite it.
    // It also stops a sale being pinned on a colleague by sending someone else's name.
    //
    // Guarded by the staffId/staffName string checks in validOrder, which short-circuit
    // before this is reached, so no path is built from a missing field.

    // Takes the id and name as arguments rather than reading fixed field names, because an
    // order and its payment both name an operator and must be judged by the SAME rule — an
    // order stores it as staffId/staffName, a payment as paidByStaffId/paidByStaffName. Two
    // copies of this logic would be two things to keep in step, and the copy nobody updated
    // would be the one that let a spoofed name through.
    function isSelfOperator(staffId, staffName) {
      return staffId == request.auth.uid && staffName == profile().displayName;
    }

    function isNamedOperator(staffId, staffName) {
      let path = /databases/$(database)/documents/staffMembers/$(staffId);
      return exists(path)
        && get(path).data.active == true
        && get(path).data.name == staffName;
    }

    function validOperator(staffId, staffName) {
      return isSelfOperator(staffId, staffName) || isNamedOperator(staffId, staffName);
    }

    function validOrder() {
      let d = request.resource.data;
      // Key set from createOrder in src/features/pos/pos-api.ts. `tableNumber` is the one
      // optional key, and validService decides which orderType may carry it — this only has
      // to permit it. carriesNoPayment stays: it says the same thing for the three legacy
      // payment keys, but as a named reason rather than as a silent absence from a list.
      return hasFields(
          ['number', 'businessDate', 'lines', 'total', 'orderType', 'createdAt', 'createdBy',
           'createdByName', 'staffId', 'staffName'],
          ['tableNumber'])
        && d.number is int && d.number > 0
        // Checked as a real date rather than "ten characters", because businessDate is what
        // every screen queries by and what the daily counter is keyed on. A malformed one
        // would file a sale under a day nothing looks at and is unfixable afterwards, orders
        // being immutable. Mirrors businessDateOf in src/features/pos/types.ts.
        && d.businessDate is string && d.businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.lines is list && d.lines.size() > 0 && d.lines.size() <= 100
        && d.total is int && d.total >= 0
        && validService(d)
        && carriesNoPayment(d)
        && d.createdBy == request.auth.uid
        && d.createdByName is string && accountNameMatches(d.createdByName)
        && d.createdAt is timestamp
        && d.staffId is string && d.staffId.size() > 0
        && d.staffName is string && d.staffName.size() > 0 && d.staffName.size() <= 60
        && validOperator(d.staffId, d.staffName);
    }

    match /orders/{orderId} {
      allow read: if isActive();
      allow create: if isActive() && validOrder();
      allow update, delete: if false;
    }

    // ---- Daily order counter -----------------------------------------------
    // Assigns the human-facing order number, in the same transaction that writes the
    // order. The increment-by-exactly-one check is what stops a tampered client skipping,
    // reusing or rewinding a number.

    // The document id IS the business date, so it is held to the same pattern an order's
    // businessDate is. Without that, a tampered client could open a counter under a
    // malformed key and mint order numbers in a day nothing queries.
    match /counters/{businessDate} {
      allow read: if isActive();
      allow create: if isActive()
        && businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && hasFields(['lastNumber'], [])
        && request.resource.data.lastNumber is int
        && request.resource.data.lastNumber == 1;
      allow update: if isActive()
        && businessDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && hasFields(['lastNumber'], [])
        && request.resource.data.lastNumber is int
        && request.resource.data.lastNumber == resource.data.lastNumber + 1;
      allow delete: if false;
    }

    // ---- Payments (any active user, final) ---------------------------------
    // Money received for an order, recorded after the fact. Its OWN document keyed by the
    // order's id, for the same reasons a void is: orders are immutable, and marking one
    // paid would mean granting update permission, which would reopen every field on every
    // sale to whoever works the till.
    //
    // Three properties fall out of keying by the order id and denying update:
    //   * an order cannot be paid twice — the second write is an update, refused;
    //   * a payment cannot be edited or withdrawn, so the record of money taken cannot be
    //     quietly rewritten;
    //   * payment status is never "set", only recorded, so there is no field for a
    //     tampered client to flip.
    //
    // Staff CREATE these, unlike voids. Taking payment is the job; voiding erases revenue
    // and stays with admins. A staff account gains nothing else from this rule.
    //
    // Every payment names TWO identities, the same pair an order does: the Firebase account
    // that was signed in (paidBy / paidByName) and the POS operator who took the money
    // (paidByStaffId / paidByStaffName). One shared login serves the whole shift, so the
    // account alone cannot say who was at the counter — which is the entire reason operator
    // identities exist, and accountability for money would be the worst place to drop it.
    //
    // No gateway is involved for e-wallet. The rules cannot and do not confirm that money
    // actually moved — the person at the counter does that on the customer's phone. What
    // the rules do enforce is that the figures recorded are internally consistent and match
    // the order they settle.

    function validCashPayment(d) {
      return d.method == 'cash'
        ? (d.cashTendered is int
           && d.cashTendered >= d.amount
           && d.changeGiven is int
           && d.changeGiven == d.cashTendered - d.amount)
        : (d.cashTendered == null && d.changeGiven == null);
    }

    function validPayment(orderId) {
      let d = request.resource.data;
      // Also proves the order exists: get() on a missing document fails the rule.
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      // Key set from recordPayment in src/features/pos/payment-api.ts. cashTendered and
      // changeGiven are REQUIRED, not optional: an e-wallet payment writes them as null
      // rather than omitting them, and validCashPayment below reads both on that branch.
      return hasFields(
          ['orderId', 'method', 'amount', 'cashTendered', 'changeGiven', 'paidAt', 'paidBy',
           'paidByName', 'paidByStaffId', 'paidByStaffName'], [])
        && d.orderId == orderId
        && d.method in ['cash', 'ewallet']
        && d.amount is int && d.amount >= 0
        // The amount settled must be the order's own total — no paying RM 1 for an RM 50
        // order, and no inflating the takings either.
        && d.amount == order.total
        && validCashPayment(d)
        && d.paidBy == request.auth.uid
        && d.paidByName is string && accountNameMatches(d.paidByName)
        && d.paidAt is timestamp
        // Who was at the counter, verified exactly as an order's operator is: either the
        // signed-in account itself (always available, which is what lets an admin settle an
        // order without picking anyone), or a named identity that exists, is active, and
        // whose CURRENT name matches what is being stored. Payments are immutable, so that
        // snapshot is provably accurate when taken and cannot be rewritten by a later
        // rename — and a payment cannot be pinned on a colleague by sending their name.
        && d.paidByStaffId is string && d.paidByStaffId.size() > 0
        && d.paidByStaffName is string && d.paidByStaffName.size() > 0
        && d.paidByStaffName.size() <= 60
        && validOperator(d.paidByStaffId, d.paidByStaffName)
        // A voided sale is cancelled; money must not be recorded against it.
        && !exists(/databases/$(database)/documents/orderVoids/$(orderId))
        // An order that carries inline payment was rung up before payment became a separate
        // step and is ALREADY paid. Without this, such an order could be paid a second time
        // — the create/update trick above only guards orders paid the new way.
        && !('paymentMethod' in order.keys());
    }

    match /orderPayments/{orderId} {
      allow read: if isActive();
      allow create: if isActive() && validPayment(orderId);
      allow update, delete: if false;
    }

    // ---- Fulfilment (any active user, forward-only) ------------------------
    // How far an order has got through being made and handed over: pending -> preparing ->
    // ready -> delivered. Its OWN document keyed by the order's id, for the same reason a
    // void and a payment are: orders are immutable, and putting a status on one would mean
    // granting update permission, which would reopen every field on every sale to whoever
    // works the kitchen.
    //
    // This is the FIRST sidecar that may be updated, because fulfilment is the one thing
    // about an order that legitimately progresses. What keeps that safe is that the rules
    // validate the TRANSITION, not merely the value:
    //
    //   * `pending` is the ABSENCE of this document, so a newly placed order needs no write
    //     and cannot be born part-way through the workflow;
    //   * create is legal only into `preparing` — the single step out of pending;
    //   * update may move exactly ONE place forward. Skipping is refused, so no client can
    //     jump an order to `delivered`, and backward is refused outright for staff;
    //   * an admin may step exactly one place BACK, to correct a mis-tap. Without that the
    //     forward path is a one-way door and a fat-fingered "delivered" is unfixable. It
    //     stays with admins for the same reason voiding does: the person undoing the
    //     mistake should not be the person who made it.
    //
    // Fulfilment says NOTHING about payment, and these rules deliberately never consult the
    // payment document. "Completed" is not stored anywhere — it is derived from both axes at
    // read time (see fulfillment.ts), so there is no third piece of state to fall out of step.

    // Position on the progression. Mirrors FULFILLMENT_STATUSES in fulfillment.ts; an
    // unknown value scores -1, which fails every comparison below rather than passing one by
    // accident. Expressing the status as a number is what makes "exactly one step" sayable.
    function fulfillmentIndex(status) {
      return status == 'pending' ? 0
        : status == 'preparing' ? 1
        : status == 'ready' ? 2
        : status == 'delivered' ? 3
        : -1;
    }

    // Who made the move, verified exactly as an order's and a payment's operator is: either
    // the signed-in account itself (always available, which is what lets an admin work
    // without picking anyone), or a named identity that exists, is active, and whose CURRENT
    // name matches what is being stored. Shared with orders and payments via validOperator,
    // so all three are judged by one definition and cannot drift apart.
    function validMover(d) {
      return d.updatedBy == request.auth.uid
        && d.updatedByName is string && accountNameMatches(d.updatedByName)
        && d.updatedByStaffId is string && d.updatedByStaffId.size() > 0
        && d.updatedByStaffName is string && d.updatedByStaffName.size() > 0
        && d.updatedByStaffName.size() <= 60
        && validOperator(d.updatedByStaffId, d.updatedByStaffName);
    }

    function validFulfillmentFields(orderId) {
      let d = request.resource.data;
      // Key set from writeTransition in src/features/pos/fulfillment-api.ts. It writes this
      // document with set() rather than update(), so it is always replaced whole — there is
      // no earlier key merged back in that this list would have to tolerate.
      // `preparingAt` is listed as OPTIONAL, not required: it is never written any more —
      // the preparation clock starts from the order's own createdAt — but documents written
      // while it was are still out there, and a merged update still carries the key. It is
      // tolerated so those orders keep moving, and read by nothing.
      return hasFields(
          ['orderId', 'status', 'updatedAt', 'updatedBy', 'updatedByName', 'updatedByStaffId',
           'updatedByStaffName', 'readyAt', 'deliveredAt'], ['preparingAt'])
        && d.orderId == orderId
        && d.status is string
        && fulfillmentIndex(d.status) >= 0
        && d.updatedAt is timestamp
        // Either a real instant or explicitly nothing.
        && (d.readyAt == null || d.readyAt is timestamp)
        && (d.deliveredAt == null || d.deliveredAt is timestamp)
        && validMover(d)
        && exists(/databases/$(database)/documents/orders/$(orderId))
        // A voided sale is cancelled; it must not continue through the kitchen.
        && !exists(/databases/$(database)/documents/orderVoids/$(orderId));
    }

    // The only legal first move: out of the implicit `pending` and into `preparing`.
    function validFulfillmentStart() {
      return request.resource.data.status == 'preparing';
    }

    // ---- Order timing --------------------------------------------------------
    // How long the customer waited, measured from when the SALE WAS RUNG UP to when the
    // order was HANDED OVER. The start is the order's own immutable `createdAt`, so nothing
    // here records it and nothing here can move it; payment has no bearing on any of it.
    //
    // `deliveredAt` is what stops the clock, and it is the one field that decides the
    // duration. `readyAt` is still recorded because it answers a different question — when
    // did the kitchen finish — but an order sitting on the pass is still an order the
    // customer has not been given, so it must not end the measurement.
    //
    // Only the finish lives on this document, and the client sends it, so it is checked
    // against `request.time` — the server's own clock for this write, which is what
    // serverTimestamp() resolves to. That is what stops a till backdating a finish to
    // flatter its numbers, or claiming one for an order it never completed. The same table
    // lives in `nextReadyAt` (fulfillment.ts) so the app knows what to send; neither is the
    // other's enforcement.
    //
    // A step that PRESERVES the finish does not write the field at all — the app merges
    // rather than replacing — so `readyAt` on such a request is the stored value itself and
    // the comparison below is trivially satisfied. Reading it behind an `in` guard still
    // matters for documents written before this field existed, where a bare
    // `resource.data.readyAt` would error the rule and deny an ordinary step.

    function priorReadyAt() {
      return 'readyAt' in resource.data ? resource.data.readyAt : null;
    }

    // A first move is always pending -> preparing, so nothing can have happened yet.
    function validPreparationCreate() {
      return request.resource.data.readyAt == null
        && request.resource.data.deliveredAt == null;
    }

    // The clock stops on exactly one step and restarts if that step is undone. There is no
    // "unchanged" case: an order is delivered or it is not, so a stale stamp cannot survive.
    function validDeliveredAt() {
      return request.resource.data.status == 'delivered'
        ? request.resource.data.deliveredAt == request.time
        : request.resource.data.deliveredAt == null;
    }

    function validPreparationUpdate() {
      let d = request.resource.data;
      let to = d.status;
      let from = resource.data.status;
      // Finishing: the one moment being measured.
      return (to == 'ready' && from == 'preparing') ? d.readyAt == request.time
        // Handing over, and the admin correction back out of it. A recorded finish stays
        // exactly as it was and remains readable for the rest of the order's life.
        : (to == 'delivered' || to == 'ready') ? d.readyAt == priorReadyAt()
        // Back into the kitchen, or all the way back to the start: the order is not
        // finished, so it must not claim to be.
        : d.readyAt == null;
    }

    function fulfillmentStepChange() {
      return fulfillmentIndex(request.resource.data.status)
        - fulfillmentIndex(resource.data.status);
    }

    match /orderFulfillment/{orderId} {
      allow read: if isActive();
      allow create: if isActive()
        && validFulfillmentFields(orderId)
        && validFulfillmentStart()
        && validPreparationCreate();
      allow update: if isActive()
        && validFulfillmentFields(orderId)
        && validPreparationUpdate()
        && validDeliveredAt()
        && (fulfillmentStepChange() == 1 || (isAdmin() && fulfillmentStepChange() == -1));
      // A record of how an order progressed is not something to erase.
      allow delete: if false;

      // ---- Transition journal (append-only) --------------------------------
      // The parent document holds only the CURRENT status and whoever moved it last, so on
      // its own it cannot answer "who started preparing this" once somebody else has marked
      // it ready — the later mover overwrites the earlier one. That is precisely the
      // question named operators exist to answer, so each step is also written here, and
      // this collection is never updated or deleted.
      //
      // The same shape as menuItemCosts (current value) alongside menuItemCostHistory
      // (append-only journal), and written in the SAME batch as the parent by
      // fulfillment-api.ts.
      //
      // `getAfter` rather than `get` is load-bearing, exactly as it is for menu item costs:
      // the parent and this entry land in one batch, so `get` would read the state BEFORE
      // the batch commits and could not see the status this entry claims to have produced.
      // Tying `to` to the parent's resulting status is what stops the journal describing a
      // move that did not happen.

      function validTransition(orderId) {
        let d = request.resource.data;
        // Key set from the second write in writeTransition (fulfillment-api.ts).
        return hasFields(
            ['orderId', 'from', 'to', 'at', 'updatedBy', 'updatedByName', 'updatedByStaffId',
             'updatedByStaffName'], [])
          && d.orderId == orderId
          && fulfillmentIndex(d.from) >= 0
          && fulfillmentIndex(d.to) >= 0
          && d.from != d.to
          && d.at is timestamp
          && validMover(d)
          && getAfter(/databases/$(database)/documents/orderFulfillment/$(orderId)).data.status
             == d.to;
      }

      match /transitions/{transitionId} {
        allow read: if isActive();
        allow create: if isActive() && validTransition(orderId);
        // Append-only: a trail that could be rewritten would not be a trail.
        allow update, delete: if false;
      }
    }

    // ---- Voids (admin-authorised, final) -----------------------------------
    // Correcting a mis-rung sale. A void is its OWN document keyed by the order's id,
    // never a flag on the order: orders are immutable, and marking one would mean granting
    // update permission, which would reopen every field on every sale to whoever can void.
    //
    // Two properties fall out of keying by the order id and denying update:
    //   * the same order cannot be voided twice — the second write is an update, refused;
    //   * a void cannot be edited or withdrawn, so the audit trail cannot be rewritten.
    //
    // Staff READ voids but cannot create one. A till operator has to know a sale was
    // cancelled; hiding it would make the orders list lie to them. Creating one erases
    // revenue, which is the classic till-fraud vector, so that stays with admins.
    //
    // **Phase 11 did not change that, and this is the point of the design.** Staff can now
    // START a void, but the write still has to arrive carrying an admin's own token:
    // `allow create: if isAdmin()` is untouched below. The app obtains that token by having
    // a manager sign in on a SECOND, in-memory Auth session (src/lib/authorizer.ts) which is
    // discarded immediately afterwards — the till's own session is never elevated, and no
    // amount of frontend tampering produces an admin token without admin credentials.
    //
    // What that buys, which a PIN could not: Firebase Auth holds the secret and throttles
    // guesses server-side. Rules cannot rate-limit, and a PIN checked by rules would have to
    // travel INSIDE the void document, where staff — who may read voids — could lift it and
    // brute-force four digits offline. See "Why a manager signs in" in README.md.

    // The initiator of a void is judged differently from an operator anywhere else, because
    // the void is written by the MANAGER's token: request.auth.uid is the authoriser, so
    // isSelfOperator's "the caller is the operator" test cannot apply to the till.
    //
    // This is the account-identity equivalent of isNamedOperator: the claimed initiator must
    // be a real, still-active user profile whose CURRENT displayName matches the name
    // recorded. It cannot prove that person physically initiated the void — the authorising
    // manager attests to that — but it does stop a name being invented wholesale.
    function isAccountOperator(staffId, staffName) {
      let path = /databases/$(database)/documents/users/$(staffId);
      return exists(path)
        && get(path).data.active == true
        && get(path).data.displayName == staffName;
    }

    // Either form of operator the till offers: a named roster member, the calling account
    // itself (an admin voiding their own sale), or — the case unique to voids — the till
    // account that started it while somebody else authorised it.
    function validInitiator(staffId, staffName) {
      return validOperator(staffId, staffName) || isAccountOperator(staffId, staffName);
    }

    function validVoid(orderId) {
      let d = request.resource.data;
      // Key set from voidOrder in src/features/pos/void-api.ts.
      return hasFields(
          ['orderId', 'reason', 'amount', 'voidedAt', 'voidedBy', 'voidedByName',
           'initiatedByStaffId', 'initiatedByStaffName'], [])
        && d.orderId == orderId
        && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 200
        && d.amount is int && d.amount >= 0
        // Also proves the order exists: get() on a missing document fails the rule.
        && d.amount == get(/databases/$(database)/documents/orders/$(orderId)).data.total
        // Who AUTHORISED it: always the caller, and always an admin (see the match below).
        && d.voidedBy == request.auth.uid
        && d.voidedByName is string && accountNameMatches(d.voidedByName)
        // Who INITIATED it: on an admin's own void, the same person; on a staff-initiated
        // one, the operator at the till. Required either way, so every void answers both
        // questions rather than leaving the second to be inferred from the first.
        && d.initiatedByStaffId is string && d.initiatedByStaffId.size() > 0
        && d.initiatedByStaffName is string && d.initiatedByStaffName.size() > 0
        && d.initiatedByStaffName.size() <= 60
        && validInitiator(d.initiatedByStaffId, d.initiatedByStaffName)
        && d.voidedAt is timestamp;
    }

    match /orderVoids/{orderId} {
      allow read: if isActive();
      allow create: if isAdmin() && validVoid(orderId);
      allow update, delete: if false;
    }

    // ---- Default deny ------------------------------------------------------
    // Everything not matched above is refused. Later phases add explicit matches
    // rather than loosening this.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
