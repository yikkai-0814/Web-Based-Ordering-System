# Copy this file to .env.local and fill in the values from your own Firebase project.
#
#   Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup
#
# These are NOT secrets. A Firebase web config identifies the project; it does not grant
# access to anything. Firestore security rules are what protect the data. Even so,
# .env.local is gitignored so that each developer points at their own project.
#
# Every variable below is required — the app refuses to start with a readable error if any
# one of them is missing (see src/lib/env.ts).

VITE_FIREBASE_API_KEY=AIzaSyEXAMPLE-REPLACE-ME-0000000000000
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Set to "true" for local development against the Firebase Emulator Suite,
# and to "false" (or remove it) to talk to the real project.
VITE_USE_EMULATORS=true
